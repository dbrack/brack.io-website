---
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import Projects from '../components/Projects.astro';
import Friends from '../components/Friends.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Dominik Brack | Product Person & Software Engineer';
const description =
  'Personal website of Dominik Brack, a product-minded software engineer building thoughtful, privacy-conscious apps including Cillia and Masqer.';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Dominik Brack',
	url: 'https://brack.io/',
	jobTitle: 'Product Person & Software Engineer',
	sameAs: [
		'https://linkedin.com/in/dominikbrack',
		'https://github.com/dbrack',
		'https://me.dm/@dbr',
		'https://twitter.com/_bracky',
	],
};
---

<BaseLayout title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main class="home">
		<section class="intro" aria-labelledby="intro-title">
			<Header />
			<Navigation />
		</section>

		<Projects />
		<Friends />
	</main>
</BaseLayout>
