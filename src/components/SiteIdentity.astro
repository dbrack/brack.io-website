<div class="site-identity">
	<a class="site-identity__link" href="/" aria-label="brack.io home">
		<img class="waypoint waypoint--dark" src="/brand/waypoint-dark.svg" width="22" height="36" alt="" />
		<img class="waypoint waypoint--light" src="/brand/waypoint-light.svg" width="22" height="36" alt="" />
		<span>brack.io</span>
	</a>
	<fieldset class="theme-control" id="theme-control" hidden>
		<legend class="sr-only">Color theme</legend>
		<label class="theme-control__option" title="Automatic (system theme)">
			<input type="radio" name="theme" value="system" aria-label="Automatic (system theme)" checked />
			<svg class="theme-control__ring" aria-hidden="true" focusable="false" width="32" height="32" viewBox="0 0 32 32">
				<circle cx="16" cy="16" r="15.375" />
			</svg>
			<svg class="theme-control__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M5 20 12 4l7 16M7.625 14h8.75" />
			</svg>
		</label>
		<label class="theme-control__option" title="Dark theme">
			<input type="radio" name="theme" value="dark" aria-label="Dark theme" />
			<svg class="theme-control__ring" aria-hidden="true" focusable="false" width="32" height="32" viewBox="0 0 32 32">
				<circle cx="16" cy="16" r="15.375" />
			</svg>
			<svg class="theme-control__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" />
			</svg>
		</label>
		<label class="theme-control__option" title="Light theme">
			<input type="radio" name="theme" value="light" aria-label="Light theme" />
			<svg class="theme-control__ring" aria-hidden="true" focusable="false" width="32" height="32" viewBox="0 0 32 32">
				<circle cx="16" cy="16" r="15.375" />
			</svg>
			<svg class="theme-control__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
			</svg>
		</label>
	</fieldset>
</div>
