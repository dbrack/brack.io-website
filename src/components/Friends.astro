---
import { friends } from '../data/friends';
---

<section class="friends" aria-labelledby="friends-title">
	<div class="section-heading">
		<h2 id="friends-title">Friends</h2>
		<p class="friends__intro">A few independent projects I like and happily recommend.</p>
	</div>

	<ul class="project-list project-list--friends">
		{
			friends.map((friend) => (
				<li class="project-list__item">
					<article>
						<h3>
							<a href={friend.href}>
								{friend.title}
								<span class="project-link__icon" aria-hidden="true">
									<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path
											d="M5 11L11 5M6 5H11V10"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="1.5"
										/>
									</svg>
								</span>
							</a>
						</h3>
						<p>{friend.description}</p>
					</article>
				</li>
			))
		}
	</ul>
</section>
